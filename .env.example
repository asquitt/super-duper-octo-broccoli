# Environment Variables Configuration
# Copy this file to .env and fill in your values

# General Settings
CLIP_EXTRACTOR_NUM_CLIPS=5
CLIP_EXTRACTOR_MIN_DURATION=30
CLIP_EXTRACTOR_MAX_DURATION=60

# AWS Configuration (if using AWS Lambda)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=your-bucket-name

# GCP Configuration (if using Google Cloud)
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Azure Configuration (if using Azure)
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_KEY=your_storage_key
AZURE_RESOURCE_GROUP=clip-extractor-rg

# OpenAI API (if using LLM-based fusion)
OPENAI_API_KEY=your_openai_api_key

# Anthropic API (alternative LLM)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Processing Options
CLIP_EXTRACTOR_TEMP_DIR=./temp
CLIP_EXTRACTOR_CACHE_DIR=./cache
